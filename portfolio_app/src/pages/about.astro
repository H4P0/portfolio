---
import '../styles/global.css';
---

<!DOCTYPE html>
<html class="dark" lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Harold Pacheco - About</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;700&display=swap"
		/>
		<link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons" />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
	</head>
	<body class="page-about min-h-screen flex items-center justify-center p-4 lg:p-12 relative overflow-x-hidden text-gray-300 font-display transition-colors duration-300">
		<!-- Subtle Background Grid -->
		<div class="about-grid-bg absolute inset-0 z-0 opacity-[0.03] pointer-events-none" aria-hidden="true"></div>

		<!-- Main Content Wrapper -->
		<main class="relative z-10 w-full max-w-7xl mx-auto">
			<!-- Header / Breadcrumb -->
			<a href="/" class="mb-8 inline-flex items-center space-x-2 text-sm text-primary font-mono opacity-80 hover:opacity-100 transition-opacity">
				<span class="material-icons text-base" aria-hidden="true">terminal</span>
				<span>root@harold:~/about</span>
			</a>

			<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16">
				<!-- Left Column: Visual Anchor -->
				<div class="lg:col-span-5 flex flex-col space-y-6">
					<!-- Profile Image Container -->
					<div class="relative group">
						<div class="absolute -top-2 -left-2 w-8 h-8 border-t-2 border-l-2 border-primary rounded-tl-lg transition-all group-hover:w-16 group-hover:h-16" aria-hidden="true"></div>
						<div class="absolute -bottom-2 -right-2 w-8 h-8 border-b-2 border-r-2 border-primary rounded-br-lg transition-all group-hover:w-16 group-hover:h-16" aria-hidden="true"></div>
						<div class="glitch-container relative rounded-xl overflow-hidden aspect-[4/5] bg-card-dark border border-card-border shadow-2xl">
							<img
								alt="Retrato profesional de Harold Pacheco, desarrollador"
								class="w-full h-full object-cover opacity-90 transition-transform duration-700 group-hover:scale-105 filter grayscale contrast-125 group-hover:grayscale-0"
								src="https://lh3.googleusercontent.com/aida-public/AB6AXuBmGiHVBTq5u-BmciC71Q9pGyImYJ7JRlSZBbUrnRxAUNjXBU_boxCkhN-J7jbWkWsunDxFIpzEf8fx8JPI_JZTFnZ31D3zV8bS5iGAurpOu8emFjEouHGNNQ8TPWZiSc4kyNOcxjRuJ6QxCYB7tmqKYpx98o4U0jrQh2JCokiaPlXGiCpIApLtMSIwX1W-eE-c3mfB_oUYqvueNg7G7HN_rK1pWtpjSvfMH0FDmMWNAQnH7KEU77mrINZkvv9t7Cnx-k1gq5o3AGE"
								width="400"
								height="500"
								fetchpriority="high"
							/>
							<div class="absolute inset-0 bg-gradient-to-t from-background-about via-transparent to-transparent opacity-80" aria-hidden="true"></div>
							<div class="absolute bottom-6 left-6 font-mono text-xs bg-black/60 backdrop-blur-md px-3 py-1 rounded text-primary border border-primary/30">
								ID: HP-8821 // ARCHITECT
							</div>
						</div>
					</div>

					<!-- Quick Stats / Socials -->
					<div class="grid grid-cols-2 gap-4">
						<a class="flex items-center space-x-3 p-4 bg-card-dark border border-card-border rounded-lg hover:border-primary/50 transition-colors group" href="https://github.com" target="_blank" rel="noopener noreferrer">
							<div class="p-2 bg-primary/10 rounded text-primary group-hover:bg-primary group-hover:text-white transition-colors">
								<span class="material-icons text-xl" aria-hidden="true">code</span>
							</div>
							<div>
								<div class="text-xs text-gray-500 uppercase tracking-wider font-mono">GitHub</div>
								<div class="font-bold text-white">@harold-dev</div>
							</div>
						</a>
						<a class="flex items-center space-x-3 p-4 bg-card-dark border border-card-border rounded-lg hover:border-primary/50 transition-colors group" href="https://linkedin.com" target="_blank" rel="noopener noreferrer">
							<div class="p-2 bg-primary/10 rounded text-primary group-hover:bg-primary group-hover:text-white transition-colors">
								<span class="material-icons text-xl" aria-hidden="true">share</span>
							</div>
							<div>
								<div class="text-xs text-gray-500 uppercase tracking-wider font-mono">LinkedIn</div>
								<div class="font-bold text-white">/in/haroldp</div>
							</div>
						</a>
					</div>

					<!-- Availability Status -->
					<div class="flex items-center justify-between p-4 bg-primary/5 border border-primary/20 rounded-lg">
						<div class="flex items-center space-x-3">
							<span class="relative flex h-3 w-3">
								<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75" aria-hidden="true"></span>
								<span class="relative inline-flex rounded-full h-3 w-3 bg-green-500"></span>
							</span>
							<span class="text-sm font-medium text-white">Open to new projects</span>
						</div>
						<a href="/#contact" class="text-xs font-mono text-primary hover:text-white transition-colors underline">Contact Me_</a>
					</div>
				</div>

				<!-- Right Column: Narrative & Technicals -->
				<div class="lg:col-span-7 flex flex-col space-y-10">
					<!-- Introduction -->
					<div class="space-y-6">
						<h1 class="text-4xl lg:text-5xl font-bold text-white tracking-tight tech-border pb-4 w-fit">
							Harold Pacheco
						</h1>
						<div class="space-y-4 text-gray-400 leading-relaxed text-lg">
							<p>
								I build digital infrastructure that <span class="text-white font-medium">scales with purpose</span>. As a Senior Software Architect, I specialize in dissecting complex problems and reconstructing them into elegant, high-performance solutions.
							</p>
							<p>
								My approach merges creative intuition with rigorous engineering. I don't just write code; I design ecosystems where <span class="text-primary font-mono text-sm bg-primary/10 px-1 py-0.5 rounded">user_experience</span> and <span class="text-primary font-mono text-sm bg-primary/10 px-1 py-0.5 rounded">system_efficiency</span> coexist seamlessly. Currently obsessed with distributed systems and the future of web assembly.
							</p>
						</div>
					</div>

					<!-- Core Principles -->
					<div>
						<h2 class="text-sm font-mono text-gray-500 uppercase tracking-widest mb-6 border-b border-card-border pb-2 flex items-center">
							<span class="material-icons text-base mr-2 text-primary" aria-hidden="true">memory</span> Core Principles
						</h2>
						<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
							<div class="group p-5 bg-card-dark border border-card-border rounded-lg hover:border-primary/40 hover:shadow-[0_0_20px_rgba(80,43,212,0.15)] transition-all duration-300">
								<div class="w-10 h-10 rounded bg-background-about flex items-center justify-center mb-4 border border-card-border group-hover:border-primary/50 text-primary">
									<span class="material-icons" aria-hidden="true">layers</span>
								</div>
								<h3 class="text-white font-bold mb-2">Scalability</h3>
								<p class="text-xs text-gray-400 leading-5">Designing architectures that grow gracefully under pressure without compromising stability.</p>
							</div>
							<div class="group p-5 bg-card-dark border border-card-border rounded-lg hover:border-primary/40 hover:shadow-[0_0_20px_rgba(80,43,212,0.15)] transition-all duration-300">
								<div class="w-10 h-10 rounded bg-background-about flex items-center justify-center mb-4 border border-card-border group-hover:border-primary/50 text-primary">
									<span class="material-icons" aria-hidden="true">speed</span>
								</div>
								<h3 class="text-white font-bold mb-2">Performance</h3>
								<p class="text-xs text-gray-400 leading-5">Obsessive optimization of load times and render cycles for fluid user interactions.</p>
							</div>
							<div class="group p-5 bg-card-dark border border-card-border rounded-lg hover:border-primary/40 hover:shadow-[0_0_20px_rgba(80,43,212,0.15)] transition-all duration-300">
								<div class="w-10 h-10 rounded bg-background-about flex items-center justify-center mb-4 border border-card-border group-hover:border-primary/50 text-primary">
									<span class="material-icons" aria-hidden="true">cleaning_services</span>
								</div>
								<h3 class="text-white font-bold mb-2">Clean Code</h3>
								<p class="text-xs text-gray-400 leading-5">Writing maintainable, self-documenting logic that future developers will thank me for.</p>
							</div>
						</div>
					</div>

					<!-- Technical Evolution Timeline -->
					<div>
						<h2 class="text-sm font-mono text-gray-500 uppercase tracking-widest mb-6 border-b border-card-border pb-2 flex items-center">
							<span class="material-icons text-base mr-2 text-primary" aria-hidden="true">history</span> Technical Evolution
						</h2>
						<div class="relative pl-4 border-l border-card-border space-y-8">
							<div class="relative group">
								<div class="absolute -left-[21px] top-1.5 w-3 h-3 rounded-full bg-card-border border-2 border-background-about group-hover:bg-primary group-hover:scale-125 transition-all" aria-hidden="true"></div>
								<div class="flex flex-col md:flex-row md:items-baseline md:justify-between mb-1">
									<h3 class="text-white font-bold text-lg">Senior Systems Architect</h3>
									<span class="font-mono text-xs text-primary bg-primary/10 px-2 py-0.5 rounded">2021 - Present</span>
								</div>
								<p class="text-sm text-gray-400">Leading backend restructuring for high-traffic fintech platforms.</p>
							</div>
							<div class="relative group">
								<div class="absolute -left-[21px] top-1.5 w-3 h-3 rounded-full bg-card-border border-2 border-background-about group-hover:bg-primary group-hover:scale-125 transition-all" aria-hidden="true"></div>
								<div class="flex flex-col md:flex-row md:items-baseline md:justify-between mb-1">
									<h3 class="text-white font-bold text-lg">Full Stack Lead</h3>
									<span class="font-mono text-xs text-gray-500">2018 - 2021</span>
								</div>
								<p class="text-sm text-gray-400">Spearheaded React/Node.js migration for legacy enterprise tools.</p>
							</div>
							<div class="relative group">
								<div class="absolute -left-[21px] top-1.5 w-3 h-3 rounded-full bg-card-border border-2 border-background-about group-hover:bg-primary group-hover:scale-125 transition-all" aria-hidden="true"></div>
								<div class="flex flex-col md:flex-row md:items-baseline md:justify-between mb-1">
									<h3 class="text-white font-bold text-lg">UI Engineer</h3>
									<span class="font-mono text-xs text-gray-500">2016 - 2018</span>
								</div>
								<p class="text-sm text-gray-400">Focused on micro-interactions and accessibility standards.</p>
							</div>
						</div>
					</div>

					<!-- Action Area -->
					<div class="pt-4 flex flex-col sm:flex-row gap-4">
						<a href="#" class="flex-1 bg-primary hover:bg-primary-light text-white font-bold py-4 px-6 rounded-lg transition-all transform hover:-translate-y-1 flex items-center justify-center space-x-2 shadow-lg shadow-primary/25">
							<span class="material-icons text-sm" aria-hidden="true">download</span>
							<span>Download CV</span>
						</a>
						<div class="flex-1 bg-card-dark border border-card-border rounded-lg p-4 flex items-center justify-between group cursor-pointer hover:border-primary/50 transition-colors">
							<div class="flex flex-col">
								<span class="text-xs text-gray-500 uppercase font-mono">Current Stack</span>
								<span class="text-white font-mono text-sm">React / Node / Rust</span>
							</div>
							<span class="material-icons text-gray-600 group-hover:text-primary transition-colors" aria-hidden="true">chevron_right</span>
						</div>
					</div>
				</div>
			</div>
		</main>

		<!-- Decorative glow effects -->
		<div class="absolute top-0 right-0 -mt-20 -mr-20 w-96 h-96 bg-primary opacity-[0.08] blur-[100px] rounded-full pointer-events-none" aria-hidden="true"></div>
		<div class="absolute bottom-0 left-0 -mb-20 -ml-20 w-96 h-96 bg-primary opacity-[0.05] blur-[100px] rounded-full pointer-events-none" aria-hidden="true"></div>
	</body>
</html>

<style>
	.page-about {
		background-color: var(--color-background-about);
		font-family: 'Space Grotesk', sans-serif;
	}

	.page-about .font-mono {
		font-family: 'JetBrains Mono', monospace;
	}

	.about-grid-bg {
		background-size: 40px 40px;
		background-image:
			linear-gradient(to right, #808080 1px, transparent 1px),
			linear-gradient(to bottom, #808080 1px, transparent 1px);
	}

	.glitch-container {
		position: relative;
		overflow: hidden;
	}

	.glitch-container::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: linear-gradient(45deg, rgba(80, 43, 212, 0.2), transparent);
		z-index: 10;
		pointer-events: none;
	}

	.tech-border {
		position: relative;
	}

	.tech-border::after {
		content: '';
		position: absolute;
		bottom: -1px;
		left: 0;
		width: 40px;
		height: 2px;
		background-color: #502bd4;
		box-shadow: 0 0 8px #502bd4;
	}

	.code-snippet {
		font-family: 'JetBrains Mono', monospace;
	}

	.page-about ::-webkit-scrollbar {
		width: 8px;
	}

	.page-about ::-webkit-scrollbar-track {
		background: #151220;
	}

	.page-about ::-webkit-scrollbar-thumb {
		background: #2d2845;
		border-radius: 4px;
	}

	.page-about ::-webkit-scrollbar-thumb:hover {
		background: #502bd4;
	}
</style>
